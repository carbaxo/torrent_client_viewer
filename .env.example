# Copia este archivo a .env y rellena tus claves (guía completa en SETUP.md).
# El archivo .env NO se sube a git.

# Buscador Torrentio (gratis, llega por email): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Catálogos Netflix/Prime/HBO/Disney+ (gratis): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Región de los catálogos (proveedores por país)
TMDB_REGION=ES

# --- Producción (descomenta cuando despliegues) ---
# Secreto largo y estable para firmar sesiones (invéntate uno):
# SESSION_SECRET=
# Cierra el registro cuando ya tengas tus cuentas creadas:
# ALLOW_REGISTRATION=false
# Ponlo a true si sirves por HTTPS:
# SECURE_COOKIE=false
