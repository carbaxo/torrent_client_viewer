# Copia este archivo a ".env" y rellena tus valores.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS/Linux:         cp .env.example .env
# El archivo .env NO se sube a git (está en .gitignore).

# --- API keys ---
# Buscador Torrentio (gratis): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Catálogos de streaming (gratis): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Opcionales ---
# Región para los catálogos (proveedores por país)
TMDB_REGION=ES

# Puerto del servidor
PORT=3000

# Secreto para firmar sesiones. En producción pon algo largo y aleatorio.
# En local puedes dejarlo vacío (se autogenera).
SESSION_SECRET=

# Pon "false" para cerrar el registro de nuevos usuarios
ALLOW_REGISTRATION=true

# Ruta a ffmpeg si no está en el PATH (normalmente no hace falta)
# FFMPEG_PATH=C:\ruta\a\ffmpeg.exe
