<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat en toda la app: el botón y el diálogo "emitir a…" de
         Chromecast lo exigen. El contenido lo dibuja Compose (MaterialTheme). -->
    <style name="Theme.TorrentBox" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0E0A0C</item>
        <item name="colorPrimary">#C62B45</item>
        <item name="colorAccent">#C62B45</item>
    </style>

    <!-- El reproductor usa AppCompat porque el diálogo de Chromecast lo requiere -->
    <style name="Theme.TorrentBox.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">#C62B45</item>
        <item name="colorAccent">#C62B45</item>
    </style>

    <!-- Icono del botón de Cast en blanco, para que se vea sobre el fondo oscuro -->
    <style name="Theme.TorrentBox.CastButton" parent="Theme.AppCompat.NoActionBar">
        <item name="colorControlNormal">#FFFFFFFF</item>
        <item name="colorPrimary">#C62B45</item>
        <item name="colorAccent">#C62B45</item>
    </style>
</resources>
