<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Modo Real-Debrid: la app no torrentea nada. Solo necesita red (buscar en
      TMDB/Torrentio y hablar con la API de Real-Debrid) y notificaciones para el
      progreso de las descargas. Sin WAKE_LOCK y sin nada corriendo en reposo: el
      único servicio en primer plano es el de una descarga EN CURSO, y desaparece
      en cuanto acaba o se pausa.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Auto-actualización: instalar el APK nuevo descargado de GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Descargas propias (pausar/continuar). Van en un Worker EN PRIMER PLANO: es
      lo que impide que el sistema las mate al cerrar la app, y en Android 14 hay
      que declarar además el tipo del servicio.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android TV: instalable en teles (no exige pantalla táctil ni leanback) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      Android 11+ oculta las demás apps instaladas. Sin declararlas aquí,
      getPackageInfo("org.videolan.vlc") falla incluso con VLC instalado y
      startActivity con setPackage() lanza ActivityNotFoundException: la opción
      de "reproducir siempre con VLC" no funcionaría.
    -->
    <queries>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <!-- Y cualquier otra app de vídeo, para el diálogo "abrir con…" -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TorrentBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Aparece también en el launcher de Android TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Pulsar un magnet en el navegador abre TorrentBox y lo deja listo
                 para añadirlo a Real-Debrid (pestaña Descargas) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <!-- "Compartir con VizPlay" un magnet o un enlace -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Reproductor incrustado de YouTube. Va aparte del PlayerActivity porque
             no es ExoPlayer: es un WebView, y así Atrás lo cierra entero sin dejar
             audio sonando por detrás. -->
        <activity
            android:name=".YtPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.TorrentBox.Player" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.TorrentBox.Player" />

        <!-- Chromecast: nuestras opciones (receptor por defecto SIN DRM, ver
             CastOptionsProvider.kt: con el receptor DRM la TV no reproducía) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.carbaxo.torrentbox.CastOptionsProvider" />

        <!-- El servicio de WorkManager necesita el tipo "dataSync" para poder
             tener la descarga en primer plano en Android 14+ -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Resultado de la sesión de instalación (auto-actualización). Va aquí y no
             registrado a mano porque una instalación que sale bien reemplaza el
             proceso, y un receptor dinámico moriría con él sin informar. -->
        <receiver
            android:name=".Installer$Receiver"
            android:exported="false" />

        <!-- Servir el APK descargado al instalador del sistema (auto-actualización) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
