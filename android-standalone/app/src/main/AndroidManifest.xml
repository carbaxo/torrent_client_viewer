<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Modo Real-Debrid: la app no torrentea nada. Solo necesita red (buscar en
      TMDB/Torrentio/apibay y hablar con la API de Real-Debrid) y notificaciones
      para el progreso de las descargas. Sin servicio en primer plano ni
      WAKE_LOCK: al cerrar la app no queda NADA corriendo. Las descargas las
      hace el DownloadManager del sistema, que sigue aunque la app esté cerrada.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Auto-actualización: instalar el APK nuevo descargado de GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android TV: instalable en teles (no exige pantalla táctil ni leanback) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/ic_launcher"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TorrentBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Aparece también en el launcher de Android TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.TorrentBox.Player" />

        <!-- Chromecast: nuestras opciones (receptor por defecto SIN DRM, ver
             CastOptionsProvider.kt: con el receptor DRM la TV no reproducía) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.carbaxo.torrentbox.CastOptionsProvider" />

        <!-- Servir el APK descargado al instalador del sistema (auto-actualización) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
