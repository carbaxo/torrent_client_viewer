{
  "name": "torrent-client-viewer",
  "version": "1.0.0",
  "description": "Busca películas y series y reprodúcelas por streaming directo con Real-Debrid (sin motor BitTorrent)",
  "author": "carbaxo",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/run.mjs",
    "electron": "electron .",
    "dist": "electron-builder --win",
    "dist:msi": "electron-builder --win msi",
    "dist:portable": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.carbaxo.torrentviewer",
    "productName": "Torrent Viewer",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": false,
    "files": [
      "electron/**",
      "server.js",
      "lib/**",
      "public/**",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "msi",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    }
  }
}
